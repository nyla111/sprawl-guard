{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 20,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/sprawl_guard.py\" pre-write || python \"${CLAUDE_PLUGIN_ROOT}/sprawl_guard.py\" pre-write"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/sprawl_guard.py\" post-write || python \"${CLAUDE_PLUGIN_ROOT}/sprawl_guard.py\" post-write"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/sprawl_guard.py\" prompt || python \"${CLAUDE_PLUGIN_ROOT}/sprawl_guard.py\" prompt"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/sprawl_guard.py\" session-start || python \"${CLAUDE_PLUGIN_ROOT}/sprawl_guard.py\" session-start"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/sprawl_guard.py\" subagent-start || python \"${CLAUDE_PLUGIN_ROOT}/sprawl_guard.py\" subagent-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/sprawl_guard.py\" stop || python \"${CLAUDE_PLUGIN_ROOT}/sprawl_guard.py\" stop"
          }
        ]
      }
    ]
  }
}
